<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-stop-factor" author="stop-factor">
        <createTable schemaName="stop_factors" tableName="stop_factor">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP(6)"/>
            <column name="updated_date" type="TIMESTAMP(6)"/>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="order_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-create-stop-factor-condition" author="stop-factor">
        <createTable schemaName="stop_factors" tableName="stop_factor_condition">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP(6)"/>
            <column name="updated_date" type="TIMESTAMP(6)"/>
            <column name="stop_factor_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_stop_factor_condition_stop_factor"
                             referencedTableSchemaName="stop_factors"
                             referencedTableName="stop_factor"
                             referencedColumnNames="id"/>
            </column>
            <column name="value" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="value_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="result" type="VARCHAR(255)"/>
        </createTable>
        <sql>
            ALTER TABLE stop_factors.stop_factor_condition
                ADD CONSTRAINT ck_stop_factor_condition_value_type CHECK (value_type IN ('STRING', 'INTEGER', 'DOUBLE', 'ARRAY')),
                ADD CONSTRAINT ck_stop_factor_condition_result CHECK (result IN ('APPROVED', 'REJECTED', 'UNDERWRITER'))
        </sql>
        <addUniqueConstraint schemaName="stop_factors"
                             tableName="stop_factor_condition"
                             columnNames="stop_factor_id, result"
                             constraintName="uq_stop_factor_condition_stop_factor_result"/>
    </changeSet>

    <changeSet id="002-create-stop-factor-check" author="stop-factor">
        <createTable schemaName="stop_factors" tableName="stop_factor_check">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_date" type="TIMESTAMP(6)"/>
            <column name="updated_date" type="TIMESTAMP(6)"/>
            <column name="scoring_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="stop_factor_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_stop_factor_check_stop_factor"
                             referencedTableSchemaName="stop_factors"
                             referencedTableName="stop_factor"
                             referencedColumnNames="id"/>
            </column>
            <column name="checked_value" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="result" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            ALTER TABLE stop_factors.stop_factor_check
                ADD CONSTRAINT ck_stop_factor_check_result CHECK (result IN ('APPROVED', 'REJECTED', 'UNDERWRITER'))
        </sql>
        <createIndex schemaName="stop_factors" tableName="stop_factor_check" indexName="idx_stop_factor_check_scoring_id">
            <column name="scoring_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-sequences" author="stop-factor">
        <createSequence schemaName="stop_factors" sequenceName="stop_factor_id_generator" startValue="1" incrementBy="1"/>
        <createSequence schemaName="stop_factors" sequenceName="stop_factor_condition_id_generator" startValue="1" incrementBy="1"/>
        <createSequence schemaName="stop_factors" sequenceName="stop_factor_check_id_generator" startValue="1" incrementBy="1"/>
    </changeSet>

</databaseChangeLog>
