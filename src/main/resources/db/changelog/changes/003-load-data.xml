<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-load-stop-factor" author="stop-factor">
        <loadData schemaName="stop_factors" tableName="stop_factor"
                  file="data/stop-factor.csv" relativeToChangelogFile="false"
                  encoding="UTF-8" separator="," quotchar='"'>
            <column name="id" type="NUMERIC"/>
            <column name="created_date" type="DATETIME"/>
            <column name="updated_date" type="DATETIME"/>
            <column name="description" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="order_number" type="NUMERIC"/>
            <column name="is_active" type="BOOLEAN"/>
        </loadData>
    </changeSet>

    <changeSet id="003-load-stop-factor-condition" author="stop-factor">
        <loadData schemaName="stop_factors" tableName="stop_factor_condition"
                  file="data/stop-factor-condition.csv" relativeToChangelogFile="false"
                  encoding="UTF-8" separator="," quotchar='"'>
            <column name="id" type="NUMERIC"/>
            <column name="created_date" type="DATETIME"/>
            <column name="updated_date" type="DATETIME"/>
            <column name="result" type="STRING"/>
            <column name="value" type="STRING"/>
            <column name="value_type" type="STRING"/>
            <column name="stop_factor_id" type="NUMERIC"/>
        </loadData>
    </changeSet>

    <changeSet id="003-sync-sequences" author="stop-factor">
        <sql>
            SELECT setval('stop_factors.stop_factor_id_generator', (SELECT COALESCE(MAX(id), 0) + 1 FROM stop_factors.stop_factor), false);
            SELECT setval('stop_factors.stop_factor_condition_id_generator', (SELECT COALESCE(MAX(id), 0) + 1 FROM stop_factors.stop_factor_condition), false);
        </sql>
    </changeSet>

</databaseChangeLog>
