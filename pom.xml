<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>kg.bakai</groupId>
    <artifactId>stop-factor-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>stop-factor-parent</name>
    <description>stop-factor</description>

    <!--
        Module graph (no cycles):

            app ──► core-console ──► stopfactor ──► product ──► common
                         └─────────────────────────────┘

        common       - base entity, exceptions, REST error handling
        product      - credit products (entity, repository, ProductService)
        stopfactor   - stop factor domain and the scoring API used by SPR (/api/v1/stop-factors);
                       uses ProductService to validate product ids
        core-console - admin console REST API (/api/v1/admin/**); the only place that needs
                       both modules at once (refuses to delete a product used by stop factors)
        app          - Spring Boot entry point, configuration, Liquibase changelogs
    -->
    <modules>
        <module>common</module>
        <module>product</module>
        <module>stopfactor</module>
        <module>core-console</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>3.2.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>kg.bakai</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>kg.bakai</groupId>
                <artifactId>product</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>kg.bakai</groupId>
                <artifactId>stopfactor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>kg.bakai</groupId>
                <artifactId>core-console</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
