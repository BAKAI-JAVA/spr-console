<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>kg.bakai</groupId>
    <artifactId>stop-factor-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>stop-factor-parent</name>
    <description>stop-factor</description>

    <!--
        Module graph (one direction only, no cycles):

            app ──► core-console ──► stopfactor  ──► common
                         └─────────► core-online ──► common

        common       - base entity, ProductSegment, exceptions, REST error handling
        core-online  - credit products of SPR (kg.bakai.product.*, table public.product), read only.
                       Must NOT import stopfactor classes
        stopfactor   - stop factor domain and the check used by SPR (StopFactorService), the local test
                       check endpoint (kg.bakai.stopfactor.testcheck) and dummies of the SPR classes it
                       reads (kg.bakai.spr.*, not copied to SPR).
                       Must NOT import core-online classes: products are read from public.product with
                       native queries of StopFactorRepository as ProductProjection
        core-console - console REST API (/api/v1/admin/**); the only module that sees both
                       stopfactor and core-online
        app          - Spring Boot entry point, configuration, Liquibase changelogs
    -->
    <modules>
        <module>common</module>
        <module>core-online</module>
        <module>stopfactor</module>
        <module>core-console</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>3.2.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>kg.bakai</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>kg.bakai</groupId>
                <artifactId>core-online</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>kg.bakai</groupId>
                <artifactId>stopfactor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>kg.bakai</groupId>
                <artifactId>core-console</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
